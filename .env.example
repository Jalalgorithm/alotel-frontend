
# ---------------------------------------------------------------------------
# Alotel Spaces — environment template. Copy to `.env` and adjust.
# Every variable exposed to the client MUST be prefixed with VITE_.
# ---------------------------------------------------------------------------

# Base URL of the backend API, including the version prefix.
# Local Django dev server: http://localhost:8000/api/v1
VITE_API_URL=http://localhost:8000/api/v1

# Catalogue + booking services. These are not wired to the backend yet, so
# leave this "true" until their endpoints are integrated.
VITE_USE_MOCK=true

# Authentication has its own switch, so it can talk to the real API while the
# rest of the app stays on mocks. Set "true" to develop auth offline.
VITE_USE_MOCK_AUTH=false

# Properties are wired to the real API independently of the rest of the
# catalogue. Set "true" to fall back to the local fixtures.
VITE_USE_MOCK_PROPERTIES=false

# Bookings, payments and identity verification.
VITE_USE_MOCK_BOOKINGS=false

# Stripe publishable key (pk_test_...). Required only for the identity
# verification modal; payments redirect to a checkout URL the server creates.
VITE_STRIPE_PUBLISHABLE_KEY=

# Simulated network latency (ms) applied to mock responses.
VITE_MOCK_LATENCY=800

# Public app metadata.
VITE_APP_NAME=Alotel Spaces
