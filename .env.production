# ---------------------------------------------------------------------------
# Alotel Spaces — deployed builds
#
# Vite picks the file by mode: `npm run dev` loads .env.development, and
# `vite build` (what Vercel runs) loads .env.production. Both are committed
# because every VITE_ value is compiled into the bundle and served to the
# browser — none of it is secret.
#
# Personal overrides belong in .env.local, which stays gitignored.
# On Vercel, dashboard environment variables override these at build time.
# ---------------------------------------------------------------------------

VITE_API_URL=https://api.alotel.synoloopsolutions.com.ng/api/v1

# Same split as development — only the wired features talk to the API.
VITE_USE_MOCK=true
VITE_USE_MOCK_AUTH=false
VITE_USE_MOCK_PROPERTIES=false
VITE_USE_MOCK_BOOKINGS=false

# Stripe publishable key (pk_live_… in production, pk_test_… locally).
# Only used by the Stripe Identity modal.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_51TRDVxV05Y1a0OZS1EMjVl2ouxQ57azg3svbSp7QqohSkbUoT2P573bLFDE3hA7jKtjRgL79rDQBTLpmPyGQcI5c00KQ0mKwjm

VITE_MOCK_LATENCY=800
VITE_APP_NAME=Alotel Spaces
